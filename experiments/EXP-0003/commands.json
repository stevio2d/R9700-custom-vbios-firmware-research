{
  "build_environment": {
    "source": "$HOME/.config/rocm/env.sh",
    "LD_LIBRARY_PATH": "/opt/rocm/core-10.1/lib/llvm/lib:/opt/rocm/core-10.1/lib"
  },
  "builds": {
    "gdn16": {
      "configure": [
        "cmake",
        "-S",
        "EXTERNAL_WORKTREE/trials/EXP-0003/gdn16/source",
        "-B",
        "EXTERNAL_WORKTREE/trials/EXP-0003/gdn16/build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DRAD_WITH_HIP=ON",
        "-DRAD_GPU_TARGETS=gfx1201",
        "-DRAD_HIP_VOPD_REPEATABLE=OFF",
        "-DCMAKE_C_COMPILER=/opt/rocm/core-10.1/lib/llvm/bin/clang",
        "-DCMAKE_CXX_COMPILER=/opt/rocm/core-10.1/lib/llvm/bin/clang++",
        "-DRAD_HIPCC=/opt/rocm/core-10.1/bin/hipcc",
        "-DRAD_HIP_RUNTIME=/opt/rocm/core-10.1/lib/libamdhip64.so",
        "-DRAD_HSA_RUNTIME=/opt/rocm/core-10.1/lib/libhsa-runtime64.so"
      ],
      "build": [
        "cmake",
        "--build",
        "EXTERNAL_WORKTREE/trials/EXP-0003/gdn16/build",
        "--target",
        "libr4d",
        "--parallel",
        "16"
      ]
    },
