        "-DRAD_HIPCC=/opt/rocm/core-10.1/bin/hipcc",
        "-DRAD_HIP_RUNTIME=/opt/rocm/core-10.1/lib/libamdhip64.so",
        "-DRAD_HSA_RUNTIME=/opt/rocm/core-10.1/lib/libhsa-runtime64.so"
